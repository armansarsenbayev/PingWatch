# Copy to .env and fill in. Never commit .env.

# Used by docker compose for the Postgres container and the api DATABASE_URL.
# Letters and digits only: it is inserted into a connection URL.
POSTGRES_PASSWORD=change-me

# Only needed when running the api outside Docker (npm run dev).
DATABASE_URL=postgresql://pingwatch:change-me@localhost:5432/pingwatch
REDIS_URL=redis://localhost:6379

NODE_ENV=development
PORT=3000
LOG_LEVEL=info
