# Copy to .env and fill in. Never commit .env.

# Used by docker compose for the Postgres container and the api DATABASE_URL.
# Letters and digits only: it is inserted into a connection URL.
POSTGRES_PASSWORD=change-me

# At least 32 random characters, for example: openssl rand -base64 48
JWT_SECRET=change-me-to-at-least-32-random-characters

# Only needed when running the api outside Docker (npm run dev).
DATABASE_URL=postgresql://pingwatch:change-me@localhost:5432/pingwatch
REDIS_URL=redis://localhost:6379

NODE_ENV=development
PORT=3000
LOG_LEVEL=info

# Development only. Lets monitors call localhost and private networks (SSRF protection off).
ALLOW_PRIVATE_TARGETS=false
